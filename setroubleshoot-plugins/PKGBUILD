pkgname='setroubleshoot-plugins'
pkgver=3.3.15
pkgrel=1
pkgdesc='Analysis plugins for use with setroubleshoot'
arch=('any')
url='https://gitlab.com/setroubleshoot/plugins'
license=('GPL-2.0-or-later')
groups=('selinux')
depends=(
  'python'
  'selinux-python'
  'libselinux'
  'python-six'
)
makedepends=(
  'perl-xml-parser'
  'intltool'
)
conflicts=('setroubleshoot<3.3.37')
source=("https://gitlab.com/setroubleshoot/plugins/-/archive/${pkgname}-${pkgver}/plugins-${pkgname}-${pkgver}.tar.gz")
sha256sums=('11c991d647dae957d865d589337749f2a85ba1401afb7cb688197ad428d05bea')

prepare() {
  cd "plugins-${pkgname}-${pkgver}"
  ./autogen.sh
}

build() {
  cd "plugins-${pkgname}-${pkgver}"
  ./configure --prefix='/usr' \
    --sbindir='/usr/bin' \
    --libexecdir="/usr/lib/${pkgname}" \
    --sysconfdir='/etc' \
    --localstatedir='/var' \
    --runstatedir='/run' \
    PYTHON='/usr/bin/python'
  make
}

package() {
  cd "plugins-${pkgname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
