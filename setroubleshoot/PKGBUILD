# This PKGBUILD is maintained on https://github.com/archlinuxhardened/selinux.
# If you want to help keep it up to date, please open a Pull Request there.

# This package has been created thanks to the Fedora package, available at
# https://src.fedoraproject.org/rpms/setroubleshoot/tree/master , and thanks to
# a contributor who suggested a PKGBUILD in
# https://github.com/archlinuxhardened/selinux/issues/15#issuecomment-480513011

pkgname='setroubleshoot'
pkgver='3.3.37'
pkgrel=1
pkgdesc='Helps troubleshoot SELinux problems'
arch=('x86_64' 'aarch64')
url='https://gitlab.com/setroubleshoot/setroubleshoot'
license=('GPL-2.0-or-later')
groups=('selinux')
depends=(
  'gtk3'
  'libnotify'
  'python'
  'python-gobject'
  'python-dasbus'
  'xdg-utils'
  "${pkgname}-plugins"
  'audit'
  'python-audit'
  'libselinux'
  'policycoreutils'
  'python-systemd'
  'dbus'
  'python-dbus'
  'polkit'
  'python-distro'
  'hicolor-icon-theme'
  'selinux-python'
  'glib2'
  'glibc'
  'libcap-ng'
)
makedepends=(
  'intltool'
  'python-setuptools'
  'python-pip'
  'desktop-file-utils'
  'git'
)
optdepends=(
  'libreport: support for automatic bug reporting'
)
source=(
  "https://gitlab.com/setroubleshoot/setroubleshoot/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz"
  "${pkgname}.tmpfiles"
  "${pkgname}.sysusers"
  '0001-Don-t-append-SELinux-level-to-context-if-MLS-disable.patch'
)
sha256sums=(
  'a8fa692670c262ffbe6efded1fc85b85b95d4d3e0e2625e1d8f82a1b6abe670a'
  '4af9c5f65c258712d275794ca659a941011916cd846d35ed2fea17411cc929fd'
  'f3ff0f1467bf7342c5557002b13c5992e4f9178fcda3e8d33716f28e20c73496'
  'ea0f106e5afdcb009d431f599c07daef42afe5936ce5d0e81fcb89748a4593a5'
)

prepare() {
  cd "${pkgname}-${pkgver}"
  patch -Np1 -i ../0001-Don-t-append-SELinux-level-to-context-if-MLS-disable.patch
  ./autogen.sh
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix='/usr' \
    --sbindir='/usr/bin' \
    --libexecdir="/usr/lib/${pkgname}" \
    --sysconfdir='/etc' \
    --localstatedir='/var' \
    --runstatedir='/run' \
    --enable-seappletlegacy='no' \
    --with-auditpluginsdir='/etc/audit/plugins.d' \
    PYTHON='/usr/bin/python'
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" \
    PREFIX=/usr \
    dbus_systemdir=/usr/share/dbus-1/system.d \
    PIP_NO_BUILD_ISOLATION=0 \
    install

  desktop-file-install --vendor="" --dir="${pkgdir}/usr/share/applications" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  mkdir -p "${pkgdir}/var/lib/${pkgname}"
  touch "${pkgdir}/var/lib/${pkgname}/setroubleshoot_database.xml"
  touch "${pkgdir}/var/lib/${pkgname}/email_alert_recipients"

  rm -rf "${pkgdir}/usr/share/doc/"

  install -m644 -D "${srcdir}/setroubleshoot.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
  install -m644 -D "${srcdir}/setroubleshoot.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
}
